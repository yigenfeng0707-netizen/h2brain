# === 应用 ===
APP_NAME=氢智行 H2Brain
APP_ENV=demo
DEBUG=true

# === 大模型（OpenAI 兼容接口）===
# 配置后启用真实 ReAct 推理，否则为演示样例模式
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.6

# === 大模型 Fallback（主用失败后自动切换，可选）===
# LLM_FALLBACK_API_KEY=your-fallback-api-key
# LLM_FALLBACK_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_FALLBACK_MODEL=qwen-plus

# === 跨域 ===
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
